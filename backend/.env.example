# WeatherGPT Phase 1 Backend - Environment Variables

# Frontend URL for CORS (e.g. http://localhost:3000, http://localhost:5173)
FRONTEND_URL=http://localhost:3000

# Optional Redis Cache (For Celery / caching. If omitted, uses in-memory or skips cache)
REDIS_URL=redis://localhost:6379/0

# Optional Database URL (For saving favorite locations, user profiles later)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weathergpt

# Weather API (Open-Meteo does not require an API key for the free tier)
# WEATHER_API_KEY=your-api-key-here

# Geoapify Geocoding API Key (Required for search and reverse geocoding)
GEOAPIFY_API_KEY=your_geoapify_key_here

# AI Service Settings
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
